/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://center.time4o.com; img-src 'self' data:; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/version.json
  Cache-Control: no-cache
